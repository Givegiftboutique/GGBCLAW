{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openclaw-dashboard-export.schema.json",
  "title": "OpenClaw Dashboard Export",
  "type": "object",
  "required": ["metadata", "metrics", "agents", "tasks", "reviews", "auditEvents", "backups", "settings", "rbac", "sourceStatus", "artifacts"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["schemaVersion", "generatedAt", "source", "generatorVersion", "safetyMode", "mutationEnabled"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "generatedAt": { "type": "string", "description": "ISO 8601 timestamp" },
        "source": { "type": "string", "enum": ["mock", "json", "artifact", "generated"] },
        "generatorVersion": { "type": "string" },
        "safetyMode": { "type": "string", "enum": ["read-only"] },
        "mutationEnabled": { "type": "boolean", "const": false }
      }
    },
    "metrics": { "type": "array", "minItems": 1 },
    "agents": { "type": "array", "minItems": 8 },
    "tasks": { "type": "array", "minItems": 8 },
    "reviews": { "type": "array" },
    "auditEvents": { "type": "array" },
    "backups": { "type": "array" },
    "settings": { "type": "object" },
    "rbac": { "type": "array" },
    "sourceStatus": { "type": "object" },
    "artifacts": { "type": "array" }
  },
  "x-safety-rules": [
    "No secrets, tokens, cookies, passwords, or API keys.",
    "No production endpoints.",
    "No mutation endpoint or production import/export action.",
    "Timestamps should use ISO 8601 format."
  ]
}
